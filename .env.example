HOST=127.0.0.1
PORT=8001
DATA_DIR=./data
MODELS_DIR=./models

INFERENCE_BACKEND=auto
PRECISION=fp16
MAX_CONCURRENT=1
MEM_BUDGET_GB=8

# Image generation uses a remote provider in this prototype.
INFERENCE_PROVIDER=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_TXT2IMG_MODEL=qwen-image-3.0-pro

# Background removal runs locally.
MATTING_PROVIDER=rembg
